# Multi-Agent Fraud Detection System Configuration

# Google Cloud / Vertex AI Configuration
GOOGLE_API_KEY=your-api-key-here
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1

# Database Configuration
DATABASE_URL=postgresql://fraud_user:fraud_pass_dev_only@localhost:5432/fraud_detection

# Kafka/Redpanda Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions
KAFKA_TOPIC_ALERTS=fraud_alerts

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Agent Configuration
TRANSACTION_MONITOR_MODEL=gemini-2.0-flash-exp
INVESTIGATOR_MODEL=gemini-2.0-flash-exp
REMEDIATION_MODEL=gemini-2.0-flash-exp

# Fraud Detection Thresholds
SUSPICIOUS_AMOUNT_THRESHOLD=5000.00
VELOCITY_CHECK_WINDOW_SECONDS=300
MAX_TRANSACTIONS_PER_WINDOW=10

# Notification Configuration (for demo)
ALERT_EMAIL=security@example.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Demo Mode
DEMO_MODE=true
GENERATE_MOCK_TRANSACTIONS=true
MOCK_TRANSACTION_INTERVAL_SECONDS=3
