# Mock Mode - Set to 'true' to test without GCP credentials (generates placeholder images/videos)
# This is perfect for testing the UI and functionality without any costs
MOCK_MODE=false

# Google Cloud Project Configuration
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1

# Cloud Storage Bucket for Video Generation
# Videos are generated to Cloud Storage, then downloaded locally
# If not specified, defaults to {project-id}-mediagen
# The bucket must exist and the service account must have write access
GCS_BUCKET_NAME=your-project-id-mediagen

# Optional: Service Account Key Path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
