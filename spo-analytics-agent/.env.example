# SPO Analytics Agent - Environment Configuration

# ============================================
# MODE SELECTION
# ============================================
# Set to 'true' to test without GCP credentials (uses mock data)
# Set to 'false' to use real Vertex AI and BigQuery
MOCK_MODE=true

# ============================================
# GCP CONFIGURATION (Required when MOCK_MODE=false)
# ============================================
# Your GCP Project ID
GCP_PROJECT_ID=your-project-id-here

# GCP Region (us-central1, us-east1, etc.)
GCP_LOCATION=us-central1

# BigQuery Dataset Name
BIGQUERY_DATASET=spo_analytics

# ============================================
# VERTEX AI / GEMINI CONFIGURATION
# ============================================
# Gemini Model to use
# Options: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash-exp

# Model temperature (0.0 - 1.0)
# Lower = more deterministic SQL generation
GEMINI_TEMPERATURE=0.2

# Max output tokens
GEMINI_MAX_TOKENS=8192

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Flask secret key (change in production)
SECRET_KEY=change-this-to-random-secret-key-in-production

# Debug mode (true/false)
DEBUG=true

# Application port
PORT=5001

# ============================================
# QUERY EXECUTION LIMITS
# ============================================
# Maximum number of rows to return
MAX_QUERY_RESULTS=10000

# Query timeout in seconds
QUERY_TIMEOUT_SECONDS=30

# Enable query result caching
ENABLE_QUERY_CACHE=true

# ============================================
# LOGGING
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
